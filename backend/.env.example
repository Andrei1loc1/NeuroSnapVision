# NeuroSnap Vision — Backend environment variables
# Copy to .env and fill real values.

# Shared secret with frontend, validated via X-Internal-Token header (secret)
# When unset, internal auth is disabled (dev mode — backend logs a warning).
INTERNAL_API_TOKEN="replace-with-shared-secret-token"

# Comma-separated list of allowed frontend origins for CORS
# Example: https://neurosnap-vision.vercel.app,http://localhost:3000
ALLOWED_ORIGINS="http://localhost:3000"

# Set to "true" to include exception detail in 500 error responses (dev only)
DEBUG=""

# Port to listen on (default 8000 locally, 7860 on HF Space)
PORT="8000"